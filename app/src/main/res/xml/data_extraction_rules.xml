<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: nothing leaves the device, neither to a cloud backup nor to a new
    phone. The app keeps session tokens here, and its data comes back from the
    server after signing in anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
